{
  "name": "ein-ui",
  "version": "0.3.0",
  "description": "A modern and customizable liquid glass UI component library built with React, Next.js, and Tailwind CSS.",
  "private": true,
  "authors": [
    "Ehsan Ghaffar <ghafari.5000@gmail.com>"
  ],
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "registry:build": "shadcn build",
    "registry:search": "shadcn search",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "version:check": "node scripts/version.mjs check",
    "version:patch": "node scripts/version.mjs bump patch",
    "version:minor": "node scripts/version.mjs bump minor",
    "version:major": "node scripts/version.mjs bump major",
    "release:notes": "node scripts/version.mjs notes"
  },
  "keywords": [],
  "license": "MIT",
  "devEngines": {
    "packageManager": [
      {
        "name": "pnpm",
        "version": "12.4.2",
        "onFail": "warn"
      }
    ]
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@vercel/analytics": "^1.6.1",
    "@wandry/analytics-sdk": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
